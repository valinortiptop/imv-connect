# IMV Portal — Supabase (your own project, NOT Lovable Cloud)
# Copy to .env and fill with values from https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...your_anon_publishable_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Service role is stored as Lovable secret IMV_SUPABASE_SERVICE_ROLE_KEY
# It is injected as process.env.IMV_SUPABASE_SERVICE_ROLE_KEY on the server only.
# Do NOT put it here.
